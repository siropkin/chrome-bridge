# S2 tab churn: burst-open 12 tabs, re-find by match, snap the big tree,
# close the burst. All in one profile — `open` needs it when several connect.
--profile @P1@ open @FX@/big.html?i=01
--profile @P1@ open @FX@/big.html?i=02
--profile @P1@ open @FX@/big.html?i=03
--profile @P1@ open @FX@/big.html?i=04
--profile @P1@ open @FX@/big.html?i=05
--profile @P1@ open @FX@/big.html?i=06
--profile @P1@ open @FX@/big.html?i=07
--profile @P1@ open @FX@/big.html?i=08
--profile @P1@ open @FX@/big.html?i=09
--profile @P1@ open @FX@/big.html?i=10
--profile @P1@ open @FX@/big.html?i=11
--profile @P1@ open @FX@/big.html?i=12
tabs big.html?i=07
--profile @P1@ snap big.html?i=07 --skeleton
--profile @P1@ close big.html?i=01
--profile @P1@ close big.html?i=02
--profile @P1@ close big.html?i=03
--profile @P1@ close big.html?i=04
--profile @P1@ close big.html?i=05
--profile @P1@ close big.html?i=06
--profile @P1@ close big.html?i=07
--profile @P1@ close big.html?i=08
--profile @P1@ close big.html?i=09
--profile @P1@ close big.html?i=10
--profile @P1@ close big.html?i=11
--profile @P1@ close big.html?i=12
