# S2 tab churn: burst-open 12 tabs, re-find by match, snap the big tree,
# close the burst. All in one profile — `open` needs it when several connect.
--profile @P1@ open @FX@/big.html?i=1
--profile @P1@ open @FX@/big.html?i=2
--profile @P1@ open @FX@/big.html?i=3
--profile @P1@ open @FX@/big.html?i=4
--profile @P1@ open @FX@/big.html?i=5
--profile @P1@ open @FX@/big.html?i=6
--profile @P1@ open @FX@/big.html?i=7
--profile @P1@ open @FX@/big.html?i=8
--profile @P1@ open @FX@/big.html?i=9
--profile @P1@ open @FX@/big.html?i=10
--profile @P1@ open @FX@/big.html?i=11
--profile @P1@ open @FX@/big.html?i=12
tabs big.html?i=7
--profile @P1@ snap big.html?i=7 --skeleton
--profile @P1@ close big.html?i=1
--profile @P1@ close big.html?i=2
--profile @P1@ close big.html?i=3
--profile @P1@ close big.html?i=4
--profile @P1@ close big.html?i=5
--profile @P1@ close big.html?i=6
--profile @P1@ close big.html?i=7
--profile @P1@ close big.html?i=8
--profile @P1@ close big.html?i=9
--profile @P1@ close big.html?i=10
--profile @P1@ close big.html?i=11
--profile @P1@ close big.html?i=12
